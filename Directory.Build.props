<Project>

  <!-- Shared settings for every project. Packing is OFF here and switched on in
       src/Directory.Build.props, so tests can never ship by accident. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <VersionPrefix>0.1.1</VersionPrefix>
    <Authors>John Campion Jr</Authors>
    <Company>Brightshore</Company>
    <Product>Hark</Product>
    <Copyright>Copyright © John Campion Jr</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/brightshore/hark</PackageProjectUrl>
    <RepositoryUrl>https://github.com/brightshore/hark</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- SourceLink (built into the SDK for GitHub): debuggers step into the exact source on GitHub.
         Symbols ship as a .snupkg next to each package. ContinuousIntegrationBuild makes CI builds
         deterministic, with paths normalised. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="'$(IsPackable)' == 'true'" />
    <None Include="$(MSBuildThisFileDirectory)build/icon.png" Pack="true" PackagePath="\" Visible="false" Condition="'$(IsPackable)' == 'true'" />
  </ItemGroup>
</Project>
