<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Hark.Sample.MainWindow"
        Title="Hark Sample"
        Width="760" Height="640" MinWidth="520" MinHeight="480">
    <DockPanel Margin="16">
        <!-- What the platform said it can do. -->
        <Border DockPanel.Dock="Top" Padding="10" CornerRadius="6" Margin="0,0,0,12"
                Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <StackPanel Spacing="2">
                <TextBlock x:Name="StatusText" FontWeight="SemiBold" Text="Connecting to the notification service…" />
                <TextBlock x:Name="CapabilitiesText" TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>
        </Border>

        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="8" ColumnSpacing="12">
            <TextBlock Grid.Row="0" Text="Title" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Text="Hello from Hark" />

            <TextBlock Grid.Row="1" Text="Body" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="BodyBox" Text="Plain text, so &lt;b&gt;this&lt;/b&gt; &amp; that stay literal." />

            <TextBlock Grid.Row="2" Text="Actions" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ActionsBox" Text="reply:Reply, mute:Mute"
                     PlaceholderText="id:Label, id:Label" />

            <TextBlock Grid.Row="3" Text="Image path" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="ImageBox" PlaceholderText="/absolute/path/to/image.png" />

            <TextBlock Grid.Row="4" Text="Tag" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TagBox"
                     PlaceholderText="Same tag replaces the one on screen" />

            <TextBlock Grid.Row="5" Text="Expires (s)" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <TextBox x:Name="ExpirationBox" Width="120" PlaceholderText="default" />
                <CheckBox x:Name="NeverExpireBox" Content="Never expire" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="Urgency" VerticalAlignment="Center" />
            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                <ComboBox x:Name="UrgencyBox" Width="140" SelectedIndex="1">
                    <ComboBoxItem Content="Low" />
                    <ComboBoxItem Content="Normal" />
                    <ComboBoxItem Content="Critical" />
                </ComboBox>
                <CheckBox x:Name="SilentBox" Content="Silent" />
            </StackPanel>
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,16,0,12">
            <Button x:Name="ShowButton" Content="Show" Classes="accent" IsEnabled="False" Click="OnShow" />
            <Button x:Name="BurstButton" Content="Show 3" IsEnabled="False" Click="OnBurst" />
            <Button x:Name="CloseButton" Content="Close last" IsEnabled="False" Click="OnCloseLast" />
            <Button Content="Clear log" Click="OnClearLog" />
        </StackPanel>

        <!-- Every call and every event, newest last. -->
        <ListBox x:Name="Log" FontFamily="{DynamicResource ContentControlThemeFontFamily}" />
    </DockPanel>
</Window>
